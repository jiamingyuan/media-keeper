{
  "name": "media-keeper-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "skills/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:api": "npm run start --workspace=@media-keeper/api",
    "keeper": "node tools/keeper.mjs",
    "build:skill": "node tools/build-skill.mjs",
    "test": "npm run build:api && node --test skills/media-keeper/test/*.test.mjs packages/core/test/*.test.mjs tests/*.test.mjs",
    "build:api": "npm run build --workspace=@media-keeper/api",
    "build:web": "npm run build --workspace=@media-keeper/web",
    "dev:web": "npm run dev --workspace=@media-keeper/web",
    "preview:web": "npm run preview --workspace=@media-keeper/web",
    "test:web": "playwright test"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "6.0.3",
    "@playwright/test": "1.64.1"
  },
  "packageManager": "npm@11.19.0"
}
