{
  "name": "@media-keeper/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dev:acomet": "vite --config vite.acomet.config.ts",
    "build:acomet": "tsc --noEmit && vite build --config vite.acomet.config.ts",
    "preview:acomet": "vite preview --config vite.acomet.config.ts"
  },
  "dependencies": {
    "@acomet/module-sdk": "0.1.0",
    "@media-keeper/core": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
